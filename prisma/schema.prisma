// GARVHEM data model. Times are stored in UTC; "workDate"-style columns are plain
// calendar dates in the company timezone (see src/lib/time.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
  ON_LEAVE
  HOLIDAY
  WEEKEND
}

enum AttendanceEventType {
  PUNCH_IN
  PUNCH_OUT
  LUNCH_START
  LUNCH_END
}

enum AttendanceEventSource {
  USER
  ADMIN_CORRECTION
  SYSTEM
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LedgerKind {
  ALLOCATION
  ACCRUAL
  CARRY_FORWARD
  DEDUCTION
  REVERSAL
  ADJUSTMENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

model User {
  id                 String    @id @default(cuid())
  employeeCode       String    @unique
  name               String
  email              String    @unique
  phone              String?
  passwordHash       String
  role               Role      @default(EMPLOYEE)
  designation        String?
  department         String?
  managerId          String?
  joiningDate        DateTime? @db.Date
  shiftStart         String? // "HH:mm" override of the company shift
  shiftEnd           String?
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  tempPasswordExpiresAt DateTime? // set for passwords generated by an admin
  tokenVersion       Int       @default(0)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  avatarUrl          String?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  manager            User?                @relation("Manager", fields: [managerId], references: [id], onDelete: SetNull)
  reports            User[]               @relation("Manager")
  sessions           Session[]
  passwordResets     PasswordResetToken[]
  attendanceDays     AttendanceDay[]
  leaveRequests      LeaveRequest[]       @relation("LeaveRequester")
  leaveDecisions     LeaveRequest[]       @relation("LeaveApprover")
  ledgerEntries      LeaveLedgerEntry[]   @relation("LedgerUser")
  ledgerActions      LeaveLedgerEntry[]   @relation("LedgerActor")
  createdTasks       Task[]               @relation("TaskCreator")
  taskAssignments    TaskAssignee[]
  taskComments       TaskComment[]
  taskActivities     TaskActivity[]
  attachments        Attachment[]
  dailyReports       DailyReport[]
  reportComments     DailyReportComment[]
  ownedLeads         Lead[]
  leadNotes          LeadNote[]
  leadStatusChanges  LeadStatusHistory[]
  notifications      Notification[]
  announcements      Announcement[]
  auditActions       AuditLog[]

  @@index([role, isActive])
  @@index([managerId])
  @@index([department])
}

model Session {
  id               String    @id @default(cuid())
  familyId         String // stable across rotations; this is the JWT "sid"
  userId           String
  refreshTokenHash String    @unique
  tokenVersion     Int       @default(0) // must match the user's, so "revoke all" can never be outrun
  userAgent        String?
  ip               String?
  rememberMe       Boolean   @default(false)
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AttendanceDay {
  id                  String           @id @default(cuid())
  userId              String
  workDate            DateTime         @db.Date
  firstIn             DateTime?
  lastOut             DateTime?
  totalMinutes        Int              @default(0)
  breakMinutes        Int              @default(0)
  netMinutes          Int              @default(0)
  lunchOverrun        Boolean          @default(false)
  lunchOverrunMinutes Int              @default(0)
  isLate              Boolean          @default(false)
  lateMinutes         Int              @default(0)
  isEarlyLeave        Boolean          @default(false)
  earlyLeaveMinutes   Int              @default(0)
  status              AttendanceStatus @default(PRESENT)
  isOpen              Boolean          @default(false) // punched in and not yet out
  autoClosed          Boolean          @default(false)
  needsReview         Boolean          @default(false)
  leaveRequestId      String?
  note                String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveRequest LeaveRequest?     @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)
  events       AttendanceEvent[]

  @@unique([userId, workDate])
  @@index([workDate, status])
  @@index([isOpen])
  @@index([needsReview])
}

model AttendanceEvent {
  id              String                @id @default(cuid())
  attendanceDayId String
  type            AttendanceEventType
  at              DateTime
  ip              String?
  userAgent       String?
  source          AttendanceEventSource @default(USER)
  createdAt       DateTime              @default(now())

  day AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)

  @@index([attendanceDayId, at])
}

model LeaveType {
  id              String   @id @default(cuid())
  name            String   @unique
  color           String   @default("#2F5BEA")
  isPaid          Boolean  @default(true)
  isUnlimited     Boolean  @default(false) // no balance check (e.g. Unpaid)
  yearlyQuota     Decimal  @default(0) @db.Decimal(5, 1)
  carryForward    Boolean  @default(false)
  maxCarryForward Decimal  @default(0) @db.Decimal(5, 1)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requests LeaveRequest[]
  ledger   LeaveLedgerEntry[]
}

model LeaveRequest {
  id           String      @id @default(cuid())
  userId       String
  leaveTypeId  String
  fromDate     DateTime    @db.Date
  toDate       DateTime    @db.Date
  firstHalfDay Boolean     @default(false) // first day is a half day
  lastHalfDay  Boolean     @default(false) // last day is a half day
  days         Decimal     @db.Decimal(5, 1)
  reason       String
  status       LeaveStatus @default(PENDING)
  approverId   String?
  decisionNote String?
  decidedAt    DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user           User               @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  approver       User?              @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  leaveType      LeaveType          @relation(fields: [leaveTypeId], references: [id])
  ledgerEntries  LeaveLedgerEntry[]
  attendanceDays AttendanceDay[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([fromDate, toDate])
}

model LeaveLedgerEntry {
  id               String     @id @default(cuid())
  userId           String
  leaveTypeId      String
  year             Int
  delta            Decimal    @db.Decimal(6, 1)
  kind             LedgerKind
  reason           String
  actorId          String?
  relatedRequestId String?
  createdAt        DateTime   @default(now())

  user           User          @relation("LedgerUser", fields: [userId], references: [id], onDelete: Cascade)
  actor          User?         @relation("LedgerActor", fields: [actorId], references: [id], onDelete: SetNull)
  leaveType      LeaveType     @relation(fields: [leaveTypeId], references: [id])
  relatedRequest LeaveRequest? @relation(fields: [relatedRequestId], references: [id], onDelete: SetNull)

  @@index([userId, year, leaveTypeId])
  @@index([createdAt])
}

model Holiday {
  id         String   @id @default(cuid())
  date       DateTime @unique @db.Date
  name       String
  isOptional Boolean  @default(false) // optional holidays do not reduce working days
  createdAt  DateTime @default(now())
}

// Typed key-value store; schema and defaults live in src/server/settings-schema.ts
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ManagerPermission {
  permission String   @id
  enabled    Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

model Task {
  id          String       @id @default(cuid())
  number      Int          @unique @default(autoincrement())
  title       String
  description String       @default("")
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @db.Date
  labels      String[]     @default([])
  client      String?
  position    Float        @default(0)
  createdById String?
  completedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdBy   User?               @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignees   TaskAssignee[]
  comments    TaskComment[]
  activities  TaskActivity[]
  checklist   TaskChecklistItem[]
  attachments Attachment[]

  @@index([status, position])
  @@index([dueDate])
  @@index([createdAt])
  @@index([deletedAt])
}

model TaskAssignee {
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String?
  body      String
  mentions  String[] @default([])
  createdAt DateTime @default(now())

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String?
  kind      String
  message   String
  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([createdAt])
}

model TaskChecklistItem {
  id       String  @id @default(cuid())
  taskId   String
  text     String
  done     Boolean @default(false)
  position Int     @default(0)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
}

model Attachment {
  id            String   @id @default(cuid())
  storageKey    String   @unique
  filename      String
  mimeType      String
  size          Int
  uploadedById  String?
  taskId        String?
  dailyReportId String?
  leadId        String?
  createdAt     DateTime @default(now())

  uploadedBy  User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  dailyReport DailyReport? @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([dailyReportId])
  @@index([leadId])
}

model DailyReport {
  id           String    @id @default(cuid())
  userId       String
  workDate     DateTime  @db.Date
  summary      String
  items        Json      @default("[]") // [{ taskId?, text, hours? }]
  blockers     String    @default("")
  tomorrowPlan String    @default("")
  links        String[]  @default([])
  lockedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments    DailyReportComment[]
  attachments Attachment[]

  @@unique([userId, workDate])
  @@index([workDate])
  @@index([createdAt])
}

model DailyReportComment {
  id        String   @id @default(cuid())
  reportId  String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt])
}

model Lead {
  id             String     @id @default(cuid())
  number         Int        @unique @default(autoincrement())
  fullName       String
  email          String
  company        String?
  country        String
  phone          String?
  services       String[]
  rolesNeeded    String?
  headcount      Int?
  budgetRange    String?
  startDate      DateTime?  @db.Date
  requirement    String
  heardFrom      String?
  sourcePage     String?
  status         LeadStatus @default(NEW)
  ownerId        String?
  followUpDate   DateTime?  @db.Date
  consentAt      DateTime
  ip             String?
  userAgent      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  owner       User?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  notes       LeadNote[]
  history     LeadStatusHistory[]
  attachments Attachment[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([country])
  @@index([ownerId])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

model LeadStatusHistory {
  id         String      @id @default(cuid())
  leadId     String
  fromStatus LeadStatus?
  toStatus   LeadStatus
  actorId    String?
  createdAt  DateTime    @default(now())

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  title     String
  body      String    @default("")
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String
  pinned    Boolean   @default(false)
  expiresAt DateTime?
  authorId  String?
  createdAt DateTime  @default(now())

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  actorId    String?
  actorLabel String?
  targetType String?
  targetId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}
