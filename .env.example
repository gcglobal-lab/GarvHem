# ─────────────────────────────────────────────────────────────────────────────
# GARVHEM environment. Copy to .env and fill in. Validated at startup by
# src/lib/env.ts: the server refuses to start if a required value is missing.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────────────────────
# Local (docker compose up -d  OR  npm run db:local):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/garvhem"
# Supabase: DATABASE_URL = "Transaction pooler" string (port 6543).
# Migrations need a direct/session connection (port 5432). Leave empty locally.
DIRECT_URL=""
# TLS. "auto" = off on localhost, encrypted with a verified certificate everywhere else (Supabase's root
# certificate is built in). "require" encrypts without verification. Set DATABASE_CA_CERT (PEM on one line
# with \n between lines) for another provider with a private CA.
DATABASE_SSL="auto"
DATABASE_CA_CERT=""

# ── App (required) ───────────────────────────────────────────────────────────
# Public origin, no trailing slash. Used for links, SEO and the Origin check.
APP_URL="http://localhost:3000"
# 256-bit secret that signs access tokens.  Generate: openssl rand -base64 48
JWT_SECRET=""
# Protects /api/cron/*. Vercel Cron sends it as "Authorization: Bearer <secret>".
CRON_SECRET=""

# ── Reverse proxy (optional) ─────────────────────────────────────────────────
# Set to "true" only when self-hosting behind a proxy you control that sets
# X-Forwarded-For. On Vercel the client IP is detected automatically.
TRUST_PROXY="false"

# ── Email (optional) ─────────────────────────────────────────────────────────
# "console" logs emails (default), "smtp" uses nodemailer, "resend" uses Resend.
EMAIL_PROVIDER="console"
EMAIL_FROM="GARVHEM <no-reply@garvhem.com>"
# Where new-lead notifications go. Defaults to the company email in Settings.
ADMIN_NOTIFY_EMAIL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
RESEND_API_KEY=""

# ── File storage ─────────────────────────────────────────────────────────────
# "local" writes to STORAGE_DIR (dev / self-host). "supabase" uses a PRIVATE
# Supabase Storage bucket (required on Vercel: its disk is not persistent).
STORAGE_PROVIDER="local"
STORAGE_DIR="./storage"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="garvhem-private"

# ── Rate limiting (optional) ─────────────────────────────────────────────────
# The database is used by default. Set both to use Upstash Redis instead.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Cloudflare Turnstile (optional) ──────────────────────────────────────────
# Set both to turn the challenge on for the public lead form.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Seed (optional) ──────────────────────────────────────────────────────────
SEED_EMAIL_DOMAIN="garvhem.com"
# If empty, strong random passwords are generated and printed once.
SEED_ADMIN_PASSWORD=""
SEED_EMPLOYEE_PASSWORD=""
